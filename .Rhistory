p_distributions <- lapply(2:ncol(server_data), function(i) {
vals <- server_data[[names(server_data)[i]]]
# Labels for histograms and density lines
fill_label <- ifelse(i < ncol(server_data), "Input signal", "Output signal")
line_label <- ifelse(i < ncol(server_data), "Input density curve", "Output density curve")
ggplot(server_data, aes(x = .data[[names(server_data)[i]]])) +
geom_histogram(aes(y = after_stat(density), fill = fill_label), bins = 30, alpha = 0.6, color = "white") +
geom_density(aes(color = line_label), linewidth = 1) +
stat_function(aes(linetype = "Normal curve (same mean, SD)"), fun = dnorm, args = list(mean = mean(vals), sd = sd(vals)), color = COLOR_REFERENCE) +
# Map the exact colors and linetypes to the labels
scale_fill_manual(name = "Data", values = c("Input signal" = COLOR_INPUT, "Output signal" = COLOR_OUTPUT)) +
scale_color_manual(name = "Curves", values = c("Input density curve" = COLOR_INPUT_DARK, "Output density curve" = COLOR_OUTPUT_DARK)) +
scale_linetype_manual(name = "Reference", values = c("Normal curve (same mean, SD)" = "dashed")) +
labs(title = paste("Distribution:", clean_labels[i - 1]), x = clean_labels[i - 1], y = "Density")
})
task_1_2_plot <- wrap_plots(p_distributions, ncol = 1) +
plot_layout(guides = "collect") +
plot_annotation(title = "Task 1.2: Distributions") &
theme(legend.position = "bottom", legend.box = "horizontal")
export_plot(task_1_2_plot, "Task_1_2_Distributions", height = 9)
