p_list_1 <- lapply(2:ncol(server_data), function(i) {
# Dynamically label as Input or Output based on column index
sig_type <- ifelse(i < ncol(server_data), "Input signal (x1 - x4)", "Output signal (y)")
ggplot(server_data, aes(x = time_seconds, y = .data[[names(server_data)[i]]])) +
# Put color INSIDE aes() to trigger the legend
geom_line(aes(color = sig_type), linewidth = 0.8) +
# Assign the correct hex codes to the labels
scale_color_manual(name = "Color key",
values = c("Input signal (x1 - x4)" = COLOR_INPUT,
"Output signal (y)" = COLOR_OUTPUT)) +
labs(title = paste("Time Series:", clean_labels[i - 1]), x = "Time (seconds)", y = clean_labels[i - 1])
})
# plot_layout(guides = "collect") extracts the legend and puts it at the bottom
task_1_1_plot <- wrap_plots(p_list_1, ncol = 1) +
plot_layout(guides = "collect") +
plot_annotation(title = "Task 1.1: Time Series of Signals") &
theme(legend.position = "bottom")
export_plot(task_1_1_plot, "Task_1_1_TimeSeries", height = 9)
