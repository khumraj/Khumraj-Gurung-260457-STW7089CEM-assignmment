vault_telemetry <- server_data[, 2:(ncol(server_data) - 1)]
vault_power     <- server_data[, ncol(server_data)]
# One simple linear model per input: power ~ x
simple_fits <- lapply(vault_telemetry, function(x) lm(vault_power ~ x))
# Correlation between each input and the output
cor_matrix <- cor(x = vault_telemetry, y = vault_power, use = "complete.obs")
# p-value (significance) and Spearman correlation (non-linear monotonic dependence)
pearson_p <- sapply(vault_telemetry, function(x) cor.test(x, vault_power)$p.value)
spearman  <- cor(vault_telemetry, vault_power, method = "spearman")
show_table("Task 1.3.1: Correlation between each Input and the Output Power",
data.frame(Input                 = clean_labels[1:4],
"Correlation (r)"           = dec(cor_matrix[, 1], 4),
"p-value"     = p_text(pearson_p),
"Rank correlation"        = dec(spearman[, 1], 4),
Intercept         = dec(sapply(simple_fits, function(m) coef(m)[1]), 4),
Slope             = dec(sapply(simple_fits, function(m) coef(m)[2]), 4),
check.names = FALSE))
p_scatters <- lapply(2:(ncol(server_data) - 1), function(i) {
ggplot(server_data, aes(x = .data[[names(server_data)[i]]], y = power_consumption)) +
geom_point(color = COLOR_INPUT, alpha = 0.25) +
geom_abline(intercept = coef(simple_fits[[i - 1]])[1], slope = coef(simple_fits[[i - 1]])[2], color = COLOR_MODEL_DARK, linewidth = 1) +
labs(title = paste(clean_labels[i - 1], "vs y (r =", dec(cor_matrix[i - 1, 1], 3), ")"), x = clean_labels[i - 1], y = clean_labels[5])
})
task_1_3_plot <- wrap_plots(p_scatters, ncol = 1) + plot_annotation(title = "Task 1.3.2: Scatter Plots")
export_plot(task_1_3_plot, "Task_1_3_2_Scatters", height = 8)
p_scatter_plots <- lapply(2:(ncol(server_data) - 1), function(i) {
ggplot(server_data, aes(x = .data[[names(server_data)[i]]], y = power_consumption)) +
# 1. Map to 'color' inside aes() to force the legend to appear
geom_point(aes(color = "Observed data"), alpha = 0.25, size = 1.5) +
geom_abline(aes(color = "Linear fit"), intercept = coef(simple_fits[[i - 1]])[1],
slope = coef(simple_fits[[i - 1]])[2], linewidth = 1) +
# 2. Manually construct the unified legend for points and lines
scale_color_manual(
name = "",
limits = c("Observed data", "Linear fit"),
values = c("Observed data" = COLOR_INPUT, "Linear fit" = COLOR_MODEL_DARK),
guide = guide_legend(
override.aes = list(
shape = c(16, NA),              # 16 = solid circle for data, NA = no shape for line
linetype = c("blank", "solid"), # blank for data, solid line for fit
size = c(3, 1),                 # Make the legend dot larger so it is easy to read
alpha = c(0.7, 1)               # Make the legend dot darker than the transparent plot points
)
)
) +
labs(title = paste0(clean_labels[i - 1], " vs y (r = ", dec(cor_matrix[i - 1, 1], 3), ")"),
x = clean_labels[i - 1], y = clean_labels[5])
})
# 3. Maintain the 1-column layout but collect the identical legends into a single key at the top
task_1_3_plot <- wrap_plots(p_scatter_plots, ncol = 1) +
plot_layout(guides = "collect") +
plot_annotation(title = "Task 1.3.2: Scatter Plots of Each Input vs Output Power") &
theme(legend.position = "top")
export_plot(task_1_3_plot, "Task_1_3_2_Scatters", height = 8)
p_scatter_plots <- lapply(2:(ncol(server_data) - 1), function(i) {
ggplot(server_data, aes(x = .data[[names(server_data)[i]]], y = power_consumption)) +
# 1. Plot the actual points
geom_point(aes(color = "Observed data"), alpha = 0.25, size = 1.5) +
# 2. Plot the actual line WITHOUT aes() to prevent the warning
geom_abline(intercept = coef(simple_fits[[i - 1]])[1],
slope = coef(simple_fits[[i - 1]])[2],
color = COLOR_MODEL_DARK, linewidth = 1) +
# 3. Add an INVISIBLE dummy line to safely force "Linear fit" into the legend
geom_line(aes(y = power_consumption, color = "Linear fit"), alpha = 0) +
# 4. Manually construct the unified legend for points and lines
scale_color_manual(
name = "",
limits = c("Observed data", "Linear fit"),
values = c("Observed data" = COLOR_INPUT, "Linear fit" = COLOR_MODEL_DARK),
guide = guide_legend(
override.aes = list(
shape    = c(16, NA),              # 16 = circle for data, NA = no shape for line
linetype = c("blank", "solid"),    # blank for data, solid line for fit
size     = c(3, 1.5),              # Slightly larger sizes so the legend is easy to read
alpha    = c(0.7, 1)               # Make legend dot opaque
)
)
) +
labs(title = paste0(clean_labels[i - 1], " vs y (r = ", dec(cor_matrix[i - 1, 1], 3), ")"),
x = clean_labels[i - 1], y = clean_labels[5])
})
task_1_3_plot <- wrap_plots(p_scatter_plots, ncol = 1) +
plot_layout(guides = "collect") +
plot_annotation(title = "Task 1.3.2: Scatter Plots of Each Input vs Output Power") &
theme(legend.position = "top")
export_plot(task_1_3_plot, "Task_1_3_2_Scatters", height = 9)
