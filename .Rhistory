# ==================================================================================================
p_distributions <- lapply(2:ncol(server_data), function(i) {
vals <- server_data[[names(server_data)[i]]]
# Determine colors based on whether it is an input (x1-x4) or output (y)
fill_color <- ifelse(i < ncol(server_data), COLOR_INPUT, COLOR_OUTPUT)
line_color <- ifelse(i < ncol(server_data), COLOR_INPUT_DARK, COLOR_OUTPUT_DARK)
ggplot(server_data, aes(x = .data[[names(server_data)[i]]])) +
# 1. Plot the actual data but HIDE their automatic legends (show.legend = FALSE)
geom_histogram(aes(y = after_stat(density)), fill = fill_color, alpha = 0.6, color = "white", bins = 30, show.legend = FALSE) +
geom_density(color = line_color, linewidth = 1, show.legend = FALSE) +
stat_function(fun = dnorm, args = list(mean = mean(vals), sd = sd(vals)), color = COLOR_REFERENCE, linetype = "dashed", linewidth = 1, show.legend = FALSE) +
# 2. Add invisible lines (alpha = 0) to force the exact 5 legend labels we want to appear
geom_line(aes(color = "Input signal (x1 - x4)"), alpha = 0) +
geom_line(aes(color = "Input density curve"), alpha = 0) +
geom_line(aes(color = "Output signal (y)"), alpha = 0) +
geom_line(aes(color = "Output density curve"), alpha = 0) +
geom_line(aes(color = "Normal curve (same mean, SD)"), alpha = 0) +
# 3. Completely hijack the color scale to draw squares, solid lines, and dashed lines
scale_color_manual(
name = "Color key",
limits = c("Input signal (x1 - x4)", "Input density curve", "Output signal (y)",
"Output density curve", "Normal curve (same mean, SD)"),
values = c(COLOR_INPUT, COLOR_INPUT_DARK, COLOR_OUTPUT, COLOR_OUTPUT_DARK, COLOR_REFERENCE),
guide = guide_legend(
override.aes = list(
shape    = c(15, NA, 15, NA, NA),                           # 15 = solid square for the histograms
linetype = c("blank", "solid", "blank", "solid", "dashed"), # solid/dashed lines for the curves
size     = c(6, 1, 6, 1, 1),                                # larger size for the squares
alpha    = c(0.6, 1, 0.6, 1, 1)                             # match transparency for histograms
)
)
) +
labs(title = paste("Distribution:", clean_labels[i - 1]), x = clean_labels[i - 1], y = "Density")
})
task_1_2_plot <- wrap_plots(p_distributions, ncol = 1) +
plot_layout(guides = "collect") +
plot_annotation(title = "Task 1.2: Distributions") &
theme(legend.position = "bottom")
export_plot(task_1_2_plot, "Task_1_2_Distributions", height = 8)
